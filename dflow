#!/usr/bin/env bash

# dflow: Professional Developer Flow CLI
# Commands match flow names (setup, develop, ci-verify, gh, teardown). Short aliases supported.

set -e

MAKE_TARGET=""
PURGE_DISK="false"
DEBUG_LOG="false"
VERBOSE="false"
NO_NETWORK="false"
LOAD_TEST="false"
SECURITY_TEST="false"
FULL_CLEANUP="false"
YES_BYPASS="false"
RELEASE_TYPE=""
DRY_RUN="false"
JOBS=""
STEPS_PARALLEL="true"
FEATURES="native-browser"

show_help() {
    cat <<'EOF'
Usage: dflow <command> [options]

Developer Flow CLI — commands match Kroki-Flow phases

Commands:
  setup        Initialize environment (setup phase)
  develop      Local build and test (develop phase)  [alias: dev]
  ci-verify    Containerized CI verification        [alias: repro]
  ci-shell     Interactive shell in CI container    [alias: shell]
  gh           Production CI (GitHub Actions / remote)
  release      Release management (propose/tag)
  teardown     Reclaim build and container disk      [alias: clean]

Options:
  -p, --purge           Clean all caches before running
  -d, --debug           Enable debug-level logging (RUST_LOG=debug)
  -v, --verbose         Enable verbose tool output
  -n, --no-network      Run in offline mode
  -t <type>, --test=<type>   Include tests (e.g., -t load, -t security, -t all)
  -j <n>, --jobs=<n>    Limit INTERNAL build parallelism to n threads
  -sp, --steps-parallel [true|false]  Run high-level verification steps concurrently (default: true)
  -f, --full            Deep System & Remote Cleanup (GHA caches + Podman) [teardown only]
  -y, --yes             Bypass all confirmation prompts
  -b, --branch          Propose a release branch (create PR) [release only]
  --tag                 Initiate project-wide release tag [release only]
  --release <v>         Prepare release v<v> (bump \u0026 commit) [dev only]
  --dry-run             Verification mode: skip destructive actions [release/dev only]
  --lean                Build lean core without browser engine
  -h, --help            Show this help message

Test & feature defaults:
  LOAD_TEST=false, SECURITY_TEST=false by default so `./dflow develop` only runs fmt/lint/build/test with `native-browser`.
  `ci-verify` / `ghrun` automatically force both flags true before spinning up Podman so the load + security suites run inside the container.
  Use `-t load`, `-t security`, or `-t all` (or `--test=<type>`) on `develop` to opt into the heavier suites locally.
  `--lean` drops `native-browser`; `SECURITY_TEST` adds `security-tests`; `LOAD_TEST` adds `load-tests` so Cargo never sees stray positional args.

Examples:
  dflow develop                     # quick sanity run (fmt/lint/build/test)
  dflow develop -t load -j 2        # include the native-browser load test with 2 internal jobs
  dflow dev --test=security --debug  # include auth/rate-limit/circuit-breaker security suite with extra logging
  dflow ci-verify --test=load        # redundant because ci-verify already enables load/security, but shows syntax
  dflow teardown -f -y              # full cleanup (Podman, caches) without confirmation
  dflow release -b --dry-run        # propose release branch, non-destructively
  dflow release --tag               # tag the current commit for release

Docs: https://softmentor.github.io/kroki-rs/developer-guide/04-infrastructure/environment
EOF
}

if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

# Parse command (primary names and aliases)
case "$1" in
    setup)      MAKE_TARGET="setup" ;;
    develop|dev) MAKE_TARGET="devrun" ;;
    ci-verify|repro) MAKE_TARGET="cirun" ;;
    ci-shell|shell) MAKE_TARGET="cishell" ;;
    gh)         MAKE_TARGET="ghrun" ;;
    release)    MAKE_TARGET="release" ;;
    teardown|clean) MAKE_TARGET="teardown" ;;
    -h|--help)  show_help; exit 0 ;;
    *)          echo "Unknown command: $1"; show_help; exit 1 ;;
esac
shift

if [[ "$MAKE_TARGET" == "cirun" || "$MAKE_TARGET" == "ghrun" ]]; then
    LOAD_TEST="true"
    SECURITY_TEST="true"
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --release)
            RELEASE_VERSION="$2"
            shift 2 ;;
        --release=*)
            RELEASE_VERSION="${1#*=}"
            shift ;;
        --version-check)
            EXTRA_CI_ARGS="$EXTRA_CI_ARGS --version-check"
            shift ;;
        -p|--purge)      PURGE_DISK="true"; shift ;;
        -d|--debug)      DEBUG_LOG="true"; shift ;;
        -v|--verbose)    VERBOSE="true"; shift ;;
        -n|--no-network) NO_NETWORK="true"; shift ;;
        -f|--full)       FULL_CLEANUP="true"; shift ;;
        -y|--yes)        YES_BYPASS="true"; shift ;;
        -b|--branch)     RELEASE_TYPE="branch"; shift ;;
        --tag)           RELEASE_TYPE="tag"; shift ;;
        --dry-run)       DRY_RUN="true"; shift ;;
        -t|--test)
            case "$2" in
                load) LOAD_TEST="true" ;;
                security) SECURITY_TEST="true" ;;
                all) LOAD_TEST="true"; SECURITY_TEST="true" ;;
            esac
            shift 2 ;;
        --test=load)     LOAD_TEST="true"; shift ;;
        --test=security) SECURITY_TEST="true"; shift ;;
        --test=all)      LOAD_TEST="true"; SECURITY_TEST="true"; shift ;;
        -j|--jobs)       JOBS="$2"; shift 2 ;;
        --jobs=*)        JOBS="${1#*=}"; shift ;;
        -sp|--steps-parallel)
            if [[ "$2" == "false" ]]; then STEPS_PARALLEL="false"; else STEPS_PARALLEL="true"; fi
            shift 2 ;;
        --steps-parallel=*)
            VAL="${1#*=}"
            if [[ "$VAL" == "false" ]]; then STEPS_PARALLEL="false"; else STEPS_PARALLEL="true"; fi
            shift ;;
        --lean)          FEATURES=""; shift ;;
        -h|--help)       show_help; exit 0 ;;
        -*)              echo "Unknown option: $1"; show_help; exit 1 ;;
        *)               break ;; # Stop at first positional argument
    esac
done

# --- Execution ---

# 1. Release Flow (Direct script delegation)
if [[ "$MAKE_TARGET" == "release" ]]; then
    SCRIPT=""
    [[ "$RELEASE_TYPE" == "branch" ]] && SCRIPT="src-scripts/gh-tasks/propose-release.sh"
    [[ "$RELEASE_TYPE" == "tag" ]]    && SCRIPT="src-scripts/gh-tasks/tag-release.sh"

    if [[ -z "$SCRIPT" ]]; then
        echo "❌ Error: Use -b/--branch or --tag with the release command."
        exit 1
    fi

    ARGS=""
    [[ "$DRY_RUN" == "true" ]] && ARGS="--dry-run"
    
    echo "🚀 Executing Release Task: $RELEASE_TYPE ($ARGS)"
    eval "bash $SCRIPT $ARGS"
    exit 0
fi

# 2. Release Mode (within dev command)
if [[ -n "$RELEASE_VERSION" ]]; then
    echo "📦 Preparing release v$RELEASE_VERSION..."
    
    # Check branch
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$CURRENT_BRANCH" != "v$RELEASE_VERSION" && "$CURRENT_BRANCH" != "release/v$RELEASE_VERSION" ]]; then
        echo "❌ Error: Current branch '$CURRENT_BRANCH' does not match target version '$RELEASE_VERSION'."
        echo "   Please switch to v$RELEASE_VERSION or release/v$RELEASE_VERSION first."
        exit 1
    fi

    # Check Changelog
    if ! grep -q "## \[$RELEASE_VERSION\]" CHANGELOG.md; then
        echo "❌ Error: CHANGELOG.md is missing an entry for [$RELEASE_VERSION]."
        exit 1
    fi

    # Bump version
    make bump VERSION="$RELEASE_VERSION"
    
    # Commit changes
    if ! git diff-index --quiet HEAD --; then
        echo "📝 Committing version bump..."
        git add Cargo.toml docs/myst.yml
        git commit -m "release: version bump to $RELEASE_VERSION"
    else
        echo "ℹ️  No changes to commit (already at version $RELEASE_VERSION)."
    fi
    
    echo "✅ Release preparation for v$RELEASE_VERSION complete."
    exit 0
fi

# 3. Teardown Safety Prompt
if [[ "$MAKE_TARGET" == "teardown" && "$FULL_CLEANUP" == "true" && "$YES_BYPASS" == "false" ]]; then
    echo "⚠️  CAUTION: Deep System & Remote Cleanup requested."
    echo "   This will purge local Podman storage, temp bloat, and REMOTE GHA caches."
    read -p "🤔 Are you sure you want to proceed? (y/N): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo "🚫 Teardown aborted."
        exit 0
    fi
fi

# 3. Standard Makefile Flow
POS_ARGS="$@"

CMD="make $MAKE_TARGET"
CMD="$CMD PURGE_DISK=$PURGE_DISK"
CMD="$CMD DEBUG_LOG=$DEBUG_LOG"
CMD="$CMD VERBOSE=$VERBOSE"
CMD="$CMD NO_NETWORK=$NO_NETWORK"
CMD="$CMD LOAD_TEST=$LOAD_TEST"
CMD="$CMD SECURITY_TEST=$SECURITY_TEST"
CMD="$CMD FULL_CLEANUP=$FULL_CLEANUP"
CMD="$CMD STEPS_PARALLEL=$STEPS_PARALLEL"
CMD="$CMD FEATURES=\"$FEATURES\""
CMD="$CMD CI_ARGS=\"$EXTRA_CI_ARGS $POS_ARGS\""

if [[ -n "$JOBS" ]]; then
    CMD="$CMD JOBS=$JOBS"
fi

echo "🚀 Executing: $CMD"
eval "$CMD"
